# Copy to .env and fill in. .env is git-ignored: never commit real secrets.

# development | staging | production  (anything but development requires a real SECRET_KEY)
APP_ENV=development

# JWT signing key. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=480

# PostgreSQL (docker-compose builds DATABASE_URL from these)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dentalflow

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

CLINIC_TZ=Asia/Yangon

# Failed logins allowed per IP + email within the window (seconds)
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900

# Password for the dev accounts created by seed.py
SEED_PASSWORD=dentalflow-dev
